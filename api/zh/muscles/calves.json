      "thumbUrl": "https://jahelcuadrado.github.io/ExerciseGymGigsDB/calves/ankle-circles.thumb.webp"
    },
    {
      "id": "calves/assisted-lying-calves-stretch",
      "slug": "assisted-lying-calves-stretch",
      "name": "仰卧辅助拉伸小腿",
      "muscle": "calves",
      "bodyPart": "legs",
      "equipment": "bodyweight",
      "category": "stretching",
      "secondaryMuscles": [],
      "instructions": [
        "以正确的身体排列就位——耳朵在肩膀上方，肩膀在髋部上方。",
        "仰卧，背部平贴在表面上，核心收紧。",
        "站在台阶或平台边缘，脚跟悬空。如需平衡可抓住支撑物。",
        "尽可能高地踮起脚尖，在顶部用力收紧小腿保持2秒。",
        "缓慢下放超过平台边缘，直到感受到小腿的深度拉伸。不要弹跳——掌控每一厘米。",
        "在整个保持阶段深呼吸，保持均匀。拉伸时绝不要憋气。"
      ],
      "file": "calves/assisted-lying-calves-stretch.gif",
      "gifUrl": "https://jahelcuadrado.github.io/ExerciseGymGigsDB/calves/assisted-lying-calves-stretch.gif",
      "thumbUrl": "https://jahelcuadrado.github.io/ExerciseGymGigsDB/calves/assisted-lying-calves-stretch.thumb.webp"
    },
