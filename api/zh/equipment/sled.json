    {
      "id": "abs/sledge-hammer",
      "slug": "sledge-hammer",
      "name": "锤式雪橇",
      "muscle": "abs",
      "bodyPart": "core",
      "equipment": "sled",
      "category": "strength",
      "secondaryMuscles": [],
      "instructions": [
        "给雪橇装上合适的重量，紧握把手。",
        "面对轮胎，双脚与肩同宽站立。双手在锤柄上错开握住大锤。",
        "将大锤举过头顶，然后用力砸向轮胎，由髋部和核心驱动。",
        "让大锤自然弹回，重新定位并再次击打。每组交替前手以获得均衡发展。",
        "呼吸：发力时呼气，回程时吸气。进行大重量复合动作时，深吸一口气到腹部，在最难的部分保持住。"
      ],
      "file": "abs/sledge-hammer.gif",
      "gifUrl": "https://jahelcuadrado.github.io/ExerciseGymGigsDB/abs/sledge-hammer.gif",
      "thumbUrl": "https://jahelcuadrado.github.io/ExerciseGymGigsDB/abs/sledge-hammer.thumb.webp"
    },
