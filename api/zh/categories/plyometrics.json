  "exercises": [
    {
      "id": "calves/box-jump-down-with-one-leg-stabilization",
      "slug": "box-jump-down-with-one-leg-stabilization",
      "name": "单腿跳箱下稳定",
      "muscle": "calves",
      "bodyPart": "legs",
      "equipment": "bodyweight",
      "category": "plyometrics",
      "secondaryMuscles": [],
      "instructions": [
        "以正确的身体排列就位——耳朵在肩膀上方，肩膀在髋部上方。",
        "双脚与髋到肩同宽站立。快速下蹲蓄力——弯曲膝盖和髋部积蓄张力。",
        "向上爆发，完全伸展髋部、膝盖和踝关节。如适用，摆动手臂增加高度。",
        "弯曲膝盖柔软着地，通过双腿吸收冲击。想着像猫一样无声地着地。",
        "一次训练一侧。完成一侧所有次数后再换边。以较弱一侧的次数为准。",
        "呼吸：跳跃或爆发性发力时用力呼气。在蓄力阶段吸气。"
      ],
      "file": "calves/box-jump-down-with-one-leg-stabilization.gif",
      "gifUrl": "https://jahelcuadrado.github.io/ExerciseGymGigsDB/calves/box-jump-down-with-one-leg-stabilization.gif",
      "thumbUrl": "https://jahelcuadrado.github.io/ExerciseGymGigsDB/calves/box-jump-down-with-one-leg-stabilization.thumb.webp"
    },
    {
      "id": "glutes/barbell-jump-squat",
      "slug": "barbell-jump-squat",
      "name": "杠铃深蹲跳",
      "muscle": "glutes",
      "bodyPart": "legs",
      "equipment": "barbell",
      "category": "plyometrics",
      "secondaryMuscles": [
        "hamstrings",
        "calves"
      ],
      "instructions": [
        "给杠铃装上合适的重量。双手紧握杠铃，双脚与肩同宽站立。",
        "将脚拧入地面以产生张力。深吸一口气到腹部——像在腰带扣后面吹一个气球。",
        "向后坐，就像身后有一把椅子，用脚将地面撑开。保持胸部朝向前方的镜子。",
        "用整个脚掌发力，将地面推离你来站起。站直，就像有人从头顶拉一根线。",
        "呼吸：跳跃或爆发性发力时用力呼气。在蓄力阶段吸气。"
      ],
      "file": "glutes/barbell-jump-squat.gif",
      "gifUrl": "https://jahelcuadrado.github.io/ExerciseGymGigsDB/glutes/barbell-jump-squat.gif",
      "thumbUrl": "https://jahelcuadrado.github.io/ExerciseGymGigsDB/glutes/barbell-jump-squat.thumb.webp"
    },
